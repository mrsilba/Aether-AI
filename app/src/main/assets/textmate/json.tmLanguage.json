{
  "name": "JSON",
  "scopeName": "source.json",
  "patterns": [
    {
      "name": "keyword.control.json",
      "match": "\\b(true|false|null)\\b"
    },
    {
      "name": "string.quoted.double.json",
      "begin": "\"",
      "end": "\""
    },
    {
      "name": "comment.line.json",
      "match": "(//|#).*$"
    }
  ]
}